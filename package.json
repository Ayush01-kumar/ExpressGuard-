{
  "name": "expressguard-toolkit",
  "version": "1.0.0",
  "description": "A lightweight Express middleware toolkit for request IDs, logging, rate limiting, API key authentication, and error handling.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    }
  },
  "files": ["src/", "types/", "examples/", "README.md", "LICENSE", "CHANGELOG.md", "CONTRIBUTING.md", ".env.example"],
  "engines": { "node": ">=22" },
  "peerDependencies": { "express": ">=4.18.0 <6" },
  "peerDependenciesMeta": { "@types/express": { "optional": true } },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "eslint": "^9.0.0",
    "express": "^5.1.0",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "node --test",
    "lint": "eslint src test examples",
    "check": "node --check src/index.cjs && node --check src/index.mjs && tsc --noEmit && node --test test/packageExports.test.cjs",
    "prepack": "npm run check"
  }
}
